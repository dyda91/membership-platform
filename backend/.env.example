DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform

PORT=3000

JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# Initial SUPER_ADMIN bootstrap (optional, idempotent).
# Set SUPER_ADMIN_BOOTSTRAP_ENABLED=true and provide credentials to create the
# first hidden system administrator on application startup. The account is only
# created when no SUPER_ADMIN exists and its password is never overwritten.
SUPER_ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=System Administrator

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=platform-media
MINIO_USE_SSL=false
