DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform

PORT=3000

# CORS: comma-separated allowed browser origins. Development default keeps
# http://localhost:5173 functional; configure production origins explicitly.
CORS_ORIGINS=http://localhost:5173

# Frontend base URL used to build password-reset links. Never derived from the
# request Host header.
FRONTEND_URL=http://localhost:5173

JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# Account security / session invalidation.
# sessionVersion invalidates previously issued JWTs after password changes,
# password resets and "logout all sessions".
# RESET_TOKEN_TTL_SECONDS=1800

# Global rate limiting (requests per window).
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100
# Stricter per-endpoint limits are applied to login, registration,
# forgot-password and reset-password.

# Temporary login protection after repeated failed attempts.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_BLOCK_DURATION_MS=900000

# SMTP e-mail delivery (password-reset e-mails).
# When SMTP_HOST is empty, e-mail delivery is disabled and no e-mail is sent.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@localhost

# Initial SUPER_ADMIN bootstrap (optional, idempotent).
# Set SUPER_ADMIN_BOOTSTRAP_ENABLED=true and provide credentials to create the
# first hidden system administrator on application startup. The account is only
# created when no SUPER_ADMIN exists and its password is never overwritten.
SUPER_ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=System Administrator

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=platform-media
MINIO_USE_SSL=false
