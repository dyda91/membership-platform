generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum Role {
  SUPER_ADMIN
  ARTIST
  SUBSCRIBER
}

enum TierAccessAction {
  GRANTED
  RENEWED
  TIER_CHANGED
  DATES_CHANGED
  REVOKED
  RESTORED
  MIGRATED
}

enum SecurityAction {
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  LOGIN_TEMPORARILY_BLOCKED
  LOGOUT_ALL_SESSIONS
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String?
  status       AccountStatus @default(ACTIVE)
  roles        UserRole[]
  tierId       String?
  tier         Tier?         @relation(fields: [tierId], references: [id], onDelete: SetNull)

  // Account security state. sessionVersion invalidates previously issued JWTs
  // after password security events and "logout all sessions". Failed-login
  // fields back temporary brute-force protection and are separate from status.
  sessionVersion      Int       @default(0)
  failedLoginAttempts Int       @default(0)
  loginBlockedUntil   DateTime?
  lastFailedLoginAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artist          Artist?
  posts           Post[]
  tierAssignments TierAccessAssignment[]
  tierAccessEvents TierAccessEvent[]
  tierAssignmentsCreated TierAccessAssignment[] @relation("TierAccessCreatedBy")
  tierAssignmentsUpdated TierAccessAssignment[] @relation("TierAccessUpdatedBy")
  tierAssignmentsRevoked TierAccessAssignment[] @relation("TierAccessRevokedBy")
  tierAccessActorEvents TierAccessEvent[] @relation("TierAccessActor")
  passwordResetTokens  PasswordResetToken[]
  securityAuditEvents  SecurityAuditEvent[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SecurityAuditEvent {
  id           String         @id @default(uuid())
  userId       String
  action       SecurityAction
  metadataJson String?
  createdAt    DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model UserRole {
  userId String
  role   Role

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model TierAccessAssignment {
  id           String    @id @default(uuid())
  userId       String    @unique
  tierId       String
  startsAt     DateTime
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokedById  String?
  createdById  String
  updatedById  String?
  internalNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      Tier   @relation(fields: [tierId], references: [id], onDelete: Restrict)
  createdBy User   @relation("TierAccessCreatedBy", fields: [createdById], references: [id])
  updatedBy User?  @relation("TierAccessUpdatedBy", fields: [updatedById], references: [id])
  revokedBy User?  @relation("TierAccessRevokedBy", fields: [revokedById], references: [id])
  events    TierAccessEvent[]

  @@index([userId])
  @@index([tierId])
  @@index([startsAt])
  @@index([expiresAt])
}

model TierAccessEvent {
  id               String    @id @default(uuid())
  assignmentId     String
  userId           String
  action           TierAccessAction
  previousTierId   String?
  newTierId        String?
  previousStartsAt DateTime?
  newStartsAt      DateTime?
  previousExpiresAt DateTime?
  newExpiresAt     DateTime?
  actorId          String?
  internalNote     String?

  createdAt DateTime @default(now())

  assignment   TierAccessAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousTier Tier?                @relation("PrevTier", fields: [previousTierId], references: [id], onDelete: Restrict)
  newTier      Tier?                @relation("NewTier", fields: [newTierId], references: [id], onDelete: Restrict)
  actor        User?                @relation("TierAccessActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([assignmentId])
  @@index([createdAt])
}

model Artist {
  id                String   @id @default(uuid())
  userId            String   @unique
  name              String
  description       String
  bio               String?
  presentationText  String?
  avatarUrl         String?
  bannerUrl         String?
  avatarMediaId     String?  @unique
  bannerMediaId     String?  @unique
  whatsappValue     String?
  whatsappEnabled   Boolean  @default(false)
  discordUrl        String?
  discordEnabled    Boolean  @default(false)
  contactButtonText String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMedia  Media? @relation("ArtistAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  bannerMedia  Media? @relation("ArtistBanner", fields: [bannerMediaId], references: [id], onDelete: SetNull)
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Post {
  id        String     @id @default(uuid())
  title     String?
  content   String
  status    PostStatus @default(DRAFT)
  authorId  String
  tierId    String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tier    Tier?   @relation(fields: [tierId], references: [id], onDelete: SetNull)
  media   Media[]

  @@index([authorId])
  @@index([status, createdAt])
  @@index([tierId])
}

enum MediaType {
  IMAGE
  VIDEO
}

model Media {
  id           String    @id @default(uuid())
  postId       String?
  position     Int       @default(0)
  storageKey   String
  filename     String
  originalName String
  mimeType     String
  size         Int
  type         MediaType
  width        Int?
  height       Int?
  duration     Int?

  createdAt    DateTime  @default(now())

  post         Post?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  artistAvatar Artist? @relation("ArtistAvatar")
  artistBanner Artist? @relation("ArtistBanner")

  @@index([postId])
}

model Tier {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  priority    Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                 User[]
  posts                 Post[]
  tierAccessAssignments TierAccessAssignment[]
  tierAccessEventsPrev  TierAccessEvent[] @relation("PrevTier")
  tierAccessEventsNew   TierAccessEvent[] @relation("NewTier")
}